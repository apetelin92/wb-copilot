DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wb_copilot?schema=public"
APP_ENCRYPTION_KEY="replace-with-32-char-secret-key"
APP_BASE_URL="http://localhost:3000"
AUTH_ALLOW_DEMO_LOGIN="true"
AUTH_BOOTSTRAP_ADMIN_EMAILS="owner@local.test"
INVITE_TTL_HOURS="168"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
SYNC_STALE_AFTER_HOURS="24"
WB_USE_MOCK="true"
WB_API_BASE_URL=""
WB_DAILY_SYNC_SECRET="change-me"
ERROR_TRACKING_WEBHOOK_URL=""

# Set `WB_USE_MOCK=false` to connect directly to Wildberries official APIs.
# Optional: set `WB_API_BASE_URL` only if you want to route through your own WB adapter service.
# Set `AUTH_ALLOW_DEMO_LOGIN=false` in production if demo access must be disabled.
# `AUTH_BOOTSTRAP_ADMIN_EMAILS` is a comma-separated list of emails allowed to bootstrap admin access.
# `WB_DAILY_SYNC_SECRET` protects `POST /api/jobs/daily-sync` for cron-based sync.
# `ERROR_TRACKING_WEBHOOK_URL` is optional and can point to Slack, Make, or your error collector webhook.
